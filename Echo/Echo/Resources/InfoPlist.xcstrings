{
  "sourceLanguage": "en",
  "strings": {
    "NSFaceIDUsageDescription": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Echo uses Face ID to keep your journal locked."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Echo, günlüğünü kilitli tutmak için Face ID kullanır."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Echo uses the microphone to record your voice journal entries."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Echo, sesli günlük kayıtların için mikrofonu kullanır."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Echo transcribes your recordings on this device so you can review the text before saving."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Echo, kaydetmeden önce metni gözden geçirebilmen için kayıtlarını bu cihazda yazıya döker."
          }
        }
      }
    }
  },
  "version": "1.0"
}
